# Dev-only API destination for Vite's /api proxy. Not exposed to the browser.
# Production hosting must route /api/v1/* to FastAPI; preview has no API proxy.
# Never place passwords or tokens in frontend env files.
API_PROXY_TARGET=http://127.0.0.1:8000
# Public opt-in, default OFF. Requires isolated --mode e2e as well as exact true.
# Ordinary dev and production keep batch OFF, including accidental flag=true.
VITE_ENABLE_CHECKPOINT_BATCH=false
